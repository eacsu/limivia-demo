# 复制为 .env 后填写。进程环境变量优先；不要提交真实密钥。
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# USB / GPIO / PWM
LIMIVIA_PORT=COM4
BUTTON_PIN=10
LED_PIN=6
PWM_FREQUENCY=1000
PWM_RESOLUTION=10
POLL_INTERVAL=0.02
DEBOUNCE_SECONDS=0.03

# 声音阈值（dBFS）和闪灯时序（秒）
NOISE_DB=-55
LOUD_DB=-15
MORSE_UNIT=0.10
MAX_BLINKS=20
